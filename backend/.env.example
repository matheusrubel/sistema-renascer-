# Copie para backend/.env e preencha com as credenciais do projeto Supabase.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Porta da API NestJS (padrão 3001).
PORT=3001
HOST=0.0.0.0
# URL pública da aplicação Next.js em produção.
WEB_ORIGIN=http://localhost:3000
# URL pública da API em produção (usada pelo rewrite do Next.js).
API_URL=http://localhost:3001
# Opcional. Mantenha apenas no backend; nunca exponha no navegador.
SUPABASE_SERVICE_ROLE_KEY=
